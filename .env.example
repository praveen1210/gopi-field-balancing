# GTG Vibral app — copy to .env and fill in.
# Only the PUBLIC project URL and publishable (anon) key go here.
# Never put the service-role key, database password or access tokens in this file.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
